---
// Fonts are self-hosted (bundled from @fontsource) so no visitor data goes to Google Fonts.
import '@fontsource-variable/noto-sans-jp';
import '@fontsource-variable/noto-serif-jp';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>;
}

const { title, description, schema } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;

// Build the JSON-LD object, injecting context + canonical URL.
const jsonLd = schema
  ? { '@context': 'https://schema.org', ...schema, url: canonicalURL }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://i.ytimg.com; frame-src https://www.google.com https://www.youtube-nocookie.com; form-action 'none'; base-uri 'self'; connect-src 'self';"
    />
    <meta name="description" content={description} />
    <meta name="author" content="Joseph" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={new URL(`${base}og-image.jpg`, Astro.site)} />

    <title>{title}</title>

    <!-- Structured Data -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <script src={`${base}nav.js`} defer></script>
    <script src={`${base}embeds.js`} defer></script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
