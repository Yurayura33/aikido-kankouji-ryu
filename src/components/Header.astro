---
interface Props {
  brand: string;
  brandHref?: string;
  links: { href: string; label: string }[];
}

const { brand, brandHref = '/', links } = Astro.props;
---

<nav class="nav" aria-label="Main navigation">
  <div class="nav__inner">
    <a href={brandHref} class="nav__logo">{brand}</a>
    <button type="button" class="nav__toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
      <span></span>
    </button>
    <ul id="nav-links" class="nav__links">
      {links.map(link => (
        <li><a href={link.href} class="nav__link">{link.label}</a></li>
      ))}
    </ul>
  </div>
</nav>
